{
  "name": "kyles-home-run-chaos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:targets": "node scripts/check-reachability.mjs",
    "playtest:forgiving": "node scripts/playtest-forgiving.mjs",
    "playtest": "node scripts/playtest-rounds.mjs",
    "format": "prettier --write src tests scripts *.json *.ts index.html README.md"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
